# Development environment (PowerShell)
FLASK_DEBUG=1
APP_MODE=DEVELOPPEMENT
SECRET_KEY=change-me-dev
SESSION_COOKIE_SECURE=0

# Data/config paths
SITE_ETATS=ES,HS
URL_OUVRAGE=http://localhost:5000/static/ouvrages/
NOTIFICATION_STORE=./app/data/notif/notifications.json
USERS_FILE=./app/data/users/users.json
RIGHTS_FILE=./app/data/users/droits.json
LOGIN_JOURNAL_FILE=./app/data/users/login_journal.json
LOGIN_BAN_FILE=./app/data/users/login_bans.json
LOGIN_JOURNAL_MAX_ENTRIES=2000

# Login ban (dev): include local IPs to test ban behavior
LOGIN_BAN_ENABLED=1
LOGIN_BAN_INCLUDE_LOCAL=1
LOGIN_BAN_MAX_FAILURES=5
LOGIN_BAN_WINDOW_SECONDS=600
LOGIN_BAN_DURATION_SECONDS=600
